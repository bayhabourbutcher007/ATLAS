{
  "name": "atlas-learning-navigator",
  "version": "0.1.0",
  "description": "ATLAS AI-Powered Learning Navigator - An integrated academic platform to help students organize, understand, and master their coursework",
  "main": "src/app.js",
  "scripts": {
    "start": "node src/app.js",
    "dev": "nodemon src/app.js",
    "dev:debug": "nodemon --inspect src/app.js",
    "test": "jest --detectOpenHandles --forceExit",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src/**/*.js",
    "lint:fix": "eslint src/**/*.js --fix",
    "build": "echo 'Build step for frontend assets'",
    "seed": "node scripts/seedDatabase.js",
    "docs": "jsdoc -c jsdoc.json -r src/",
    "prepare": "husky install"
  },
  "keywords": [
    "education",
    "learning",
    "student",
    "academic",
    "planner",
    "knowledge-graph",
    "ai",
    "education-technology"
  ],
  "author": "ATLAS Development Team",
  "license": "MIT",
  "engines": {
    "node": ">=16.0.0"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-validator": "^7.3.2",
    "helmet": "^7.0.0",
    "joi": "^17.13.4",
    "jsonwebtoken": "^9.0.2",
    "method-override": "^3.0.0",
    "mongoose": "^7.5.0",
    "rate-limiter-flexible": "^3.0.4"
  },
  "devDependencies": {
    "eslint": "^8.47.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-plugin-import": "^2.28.0",
    "husky": "^8.0.0",
    "jest": "^29.6.0",
    "jsdoc": "^4.0.2",
    "lint-staged": "^13.2.3",
    "mongodb-memory-server": "^11.2.0",
    "nodemon": "^3.0.1",
    "supertest": "^6.3.3"
  }
}
